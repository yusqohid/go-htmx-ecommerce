# Application
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sellora?sslmode=disable

# Authentication & Sessions
SESSION_SECRET=sellora-insecure-dev-secret-key-change-in-production-min-32-chars

# File Storage for Digital Products
STORAGE_PATH=./storage/products

# Payment Provider Configuration (midtrans | mock | lynk)
PAYMENT_PROVIDER=midtrans

# Midtrans Snap Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-YourSandboxServerKeyHere
MIDTRANS_CLIENT_KEY=SB-Mid-client-YourSandboxClientKeyHere
MIDTRANS_IS_PRODUCTION=false

# LYNK.ID Configuration (Alternative)
LYNK_API_KEY=
LYNK_WEBHOOK_SECRET=
LYNK_BASE_URL=https://api.lynk.id
# Transactional Email (SMTP / Mailtrap / SendGrid / Resend)
# Leave SMTP_HOST empty in development to log outgoing emails to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@sellora.local
SMTP_FROM_NAME=Sellora
